# Udaan AI Environment Configuration

# Flask Core
FLASK_APP=run.py
FLASK_DEBUG=false
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Configuration (Defaults to SQLite for local development; use PostgreSQL URL in production)
# DATABASE_URL=postgresql://udaan_user:password@localhost:5432/udaan
DATABASE_URL=

# AI Model Configuration (Optional: Deterministic rule fallback is active if absent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Pilot & Demo Mode Controls
DEMO_MODE=true
DEFAULT_LANGUAGE=en

# Secure Admin Bootstrap Secret Token
ADMIN_SETUP_SECRET=ChangeThisBootstrapSecretInProduction!
